{
	"info": {
		"_postman_id": "9d8e7f6a-5b4c-3a21-1098-76543210feab",
		"name": "Laravel Blog API - Password Reset (Email & Phone)",
		"description": "Complete 3-step Password Reset Collection supporting unified input (Email or Phone number).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "reset_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Register Test User (Optional)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"oldpassword123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"register"
					]
				},
				"description": "Registers a test user with both an email and a phone number."
			},
			"response": []
		},
		{
			"name": "1. Step 1: Request OTP (via Email)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.debug_otp) {",
							"    pm.environment.set(\"otp_code\", jsonData.data.debug_otp);",
							"    console.log(\"Debug OTP captured:\", jsonData.data.debug_otp);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"identifier\": \"testuser@example.com\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/password/forgot",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"password",
						"forgot"
					]
				},
				"description": "Step 1: Sends a 6-digit OTP to the user's email."
			},
			"response": []
		},
		{
			"name": "1b. Step 1: Request OTP (via Phone Number)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"identifier\": \"+1234567890\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/password/forgot",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"password",
						"forgot"
					]
				},
				"description": "Step 1 (Alternative): Sends a 6-digit OTP via SMS (logged to storage/logs/laravel.log in dev)."
			},
			"response": []
		},
		{
			"name": "2. Step 2: Verify OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.data && jsonData.data.reset_token) {",
							"    pm.collectionVariables.set(\"reset_token\", jsonData.data.reset_token);",
							"    console.log(\"Reset token set:\", jsonData.data.reset_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"identifier\": \"testuser@example.com\",\n  \"otp\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/password/verify-otp",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"password",
						"verify-otp"
					]
				},
				"description": "Step 2: Verifies the 6-digit OTP code and returns a single-use reset_token."
			},
			"response": []
		},
		{
			"name": "3. Step 3: Reset Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"identifier\": \"testuser@example.com\",\n  \"reset_token\": \"{{reset_token}}\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/password/reset",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"password",
						"reset"
					]
				},
				"description": "Step 3: Resets the password using the reset_token obtained in Step 2."
			},
			"response": []
		},
		{
			"name": "4. Verify: Login with New Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"newpassword123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"login"
					]
				},
				"description": "Verify login with the new password."
			},
			"response": []
		}
	]
}
